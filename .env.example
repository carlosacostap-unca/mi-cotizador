# Copiá este archivo como .env y completá los valores. El .env no se sube a Git.

# Dirección del servidor PocketBase (obligatoria)
POCKETBASE_URL=

# Dirección de la API que informa la cotización del dólar oficial (obligatoria
# para la carga automática; sin ella se ingresa la cotización a mano)
DOLARAPI_URL=

# Página de cotizaciones del Banco Nación (la lee cotizaciones_bna.py; obligatoria para ese programa)
BNA_URL=

# Asistente (chat) de Mi Cotizador con la API de OpenAI. Las tres son obligatorias
# para el chat; sin ellas el chat avisa cuál falta y el resto de la app funciona.
# Dirección de la API de chat (el endpoint de chat completions)
OPENAI_URL=
# Modelo a usar (el nombre que figure en tu cuenta de OpenAI)
OPENAI_MODEL=
# Tu clave de la API. Es secreta: no la compartas ni la subas a Git.
OPENAI_API_KEY=
# OPCIONAL. Algunos modelos razonan por defecto y la API de chat no permite funciones
# en ese modo (error 400 que menciona reasoning_effort). En ese caso poné: none
OPENAI_REASONING_EFFORT=

# Superusuario de PocketBase (lo usa configurar_pocketbase.py)
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# Cuenta admin de Mi Cotizador (colección users; la usa --crear-admin)
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Usuario de prueba de Mi Cotizador (rol común; lo usa capturas_conversiones.py)
PB_TEST_EMAIL=
PB_TEST_PASSWORD=
